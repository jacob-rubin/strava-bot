{
  "name": "strava-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx app/server.ts",
    "start": "node --enable-source-maps dist/app/server.js",
    "status": "node tools/status.ts next",
    "status:write": "node tools/status.ts write",
    "status:check": "node tools/status.ts check",
    "status:next": "node tools/status.ts next"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.1.0",
    "@google-cloud/secret-manager": "^7.1.0",
    "fastify": "^5.12.4",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.13.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.6": true
  }
}
