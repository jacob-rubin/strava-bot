# Local credential files. The deployed service reads these values from
# Secret Manager (docs/reference/configuration.md);
# a local .env exists only for scripts run by hand.
.env
.env.*
!.env.example

# Terraform (docs/decisions/0007-terraform-for-gcp-infra.md). State may hold
# secret material once secret versions exist, and *.tfvars carries the
# values passed at apply time; neither belongs in VCS. The provider lock file
# (.terraform.lock.hcl) is committed on purpose.
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log
*.tfplan
apply.log

# Node.js and TypeScript build output.
node_modules/
dist/

# Vitest coverage output.
coverage/

# Personal notes on ideas and next steps; kept local and copied into
# worktrees through .worktreeinclude.
/next steps/
